---
import { ads } from '../config/ads';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  index?: number;
}

const { locale, index = 0 } = Astro.props;
const cfg = ads.adsterra.native[index];
---

{cfg && (
  <section class="ad-slot" aria-label={t(locale, 'adLabel')}>
    <p class="ad-slot-label">{t(locale, 'adLabel')}</p>
    <div class="ad-slot-body">
      <script is:inline async="async" data-cfasync="false" src={cfg.src}></script>
      <div id={cfg.containerId}></div>
    </div>
  </section>
)}
