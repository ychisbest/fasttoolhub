---
import type { CollectionEntry } from 'astro:content';
import TermCard from './TermCard.astro';
import { t, type Locale } from '../i18n/ui';
import { formatDate } from '../i18n/paths';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'terms'>[];
}

const { locale, entries } = Astro.props;
const sources = [...new Set(entries.map((e) => e.data.source))].sort((a, b) =>
  a.localeCompare(b),
);

const groups: { label: string; items: CollectionEntry<'terms'>[] }[] = [];
for (const entry of entries) {
  const label = formatDate(entry.data.date, locale);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.items.push(entry);
  else groups.push({ label, items: [entry] });
}

const latest = entries[0] ? formatDate(entries[0].data.date, locale) : '';
---

<section class="hero">
  <div class="hero-copy">
    <p class="kicker">{t(locale, 'desk')}</p>
    <h1>{t(locale, 'timeline')}</h1>
    <p class="lede">{t(locale, 'timelineDesc')}</p>
  </div>
  {entries.length > 0 && (
    <dl class="desk-brief">
      <div>
        <dt>{t(locale, 'entriesCount')}</dt>
        <dd>{entries.length}</dd>
      </div>
      <div>
        <dt>{t(locale, 'latest')}</dt>
        <dd>{latest}</dd>
      </div>
      <div>
        <dt>{t(locale, 'sourcesCount')}</dt>
        <dd>{sources.length}</dd>
      </div>
    </dl>
  )}
</section>

<div class="toolbar" data-timeline-toolbar>
  <div class="search-field">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M16 16.5L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
    <label class="sr-only" for="term-search">{t(locale, 'search')}</label>
    <input
      id="term-search"
      class="input"
      type="search"
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      data-term-search
    />
  </div>
  <div class="filter-row">
    <button type="button" class="btn filter-toggle" data-filter-toggle aria-expanded="false">
      {t(locale, 'filters')}
    </button>
    <label class="source-filter">
      <span class="sr-only">{t(locale, 'filterSource')}</span>
      <select class="select" data-source-filter aria-label={t(locale, 'filterSource')}>
        <option value="">{t(locale, 'allSources')}</option>
        {sources.map((s) => <option value={s.toLowerCase()}>{s}</option>)}
      </select>
    </label>
  </div>
</div>

<div class="timeline" data-timeline>
  {entries.length === 0 ? (
    <div class="empty">
      <strong>{t(locale, 'empty')}</strong>
      <p>{t(locale, 'emptyHint')}</p>
    </div>
  ) : (
    groups.map((group) => (
      <section class="day-group" data-day-group>
        <h2 class="day-label">{group.label}</h2>
        <div class="day-list">
          {group.items.map((entry) => <TermCard locale={locale} entry={entry} />)}
        </div>
      </section>
    ))
  )}
  <div class="empty" data-no-results hidden>
    <strong>{t(locale, 'noResults')}</strong>
  </div>
</div>

<script>
  const search = document.querySelector('[data-term-search]') as HTMLInputElement | null;
  const source = document.querySelector('[data-source-filter]') as HTMLSelectElement | null;
  const cards = Array.from(document.querySelectorAll('[data-term-card]')) as HTMLElement[];
  const groups = Array.from(document.querySelectorAll('[data-day-group]')) as HTMLElement[];
  const empty = document.querySelector('[data-no-results]') as HTMLElement | null;
  const filterBtn = document.querySelector('[data-filter-toggle]') as HTMLButtonElement | null;
  const toolbar = document.querySelector('[data-timeline-toolbar]') as HTMLElement | null;

  function applyFilter() {
    const q = (search?.value || '').trim().toLowerCase();
    const src = (source?.value || '').trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const term = card.dataset.term || '';
      const excerpt = card.dataset.excerpt || '';
      const cardSource = card.dataset.source || '';
      const matchQ = !q || term.includes(q) || excerpt.includes(q) || cardSource.includes(q);
      const matchS = !src || cardSource === src;
      const show = matchQ && matchS;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    }
    for (const group of groups) {
      const any = group.querySelector('[data-term-card]:not([hidden])');
      group.toggleAttribute('hidden', !any);
    }
    empty?.toggleAttribute('hidden', visible !== 0 || cards.length === 0);
  }

  filterBtn?.addEventListener('click', () => {
    const open = toolbar?.classList.toggle('is-open') ?? false;
    filterBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  search?.addEventListener('input', applyFilter);
  source?.addEventListener('change', applyFilter);
</script>
