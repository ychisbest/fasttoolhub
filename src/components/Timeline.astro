---
import type { CollectionEntry } from 'astro:content';
import TermCard from './TermCard.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'terms'>[];
}

const { locale, entries } = Astro.props;
const sources = [...new Set(entries.map((e) => e.data.source))].sort((a, b) =>
  a.localeCompare(b),
);
---

<section class="hero" data-testid="directory-discover-hero">
  <h1>{t(locale, 'heroTitle')}</h1>
  <p class="hero-sub">{t(locale, 'heroSubtitle')}</p>
</section>

<form
  class="discovery-controls"
  data-testid="directory-discovery-controls"
  data-timeline-toolbar
  onsubmit="return false"
>
  <div class="search-field">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
      <path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
    </svg>
    <label class="sr-only" for="term-search">{t(locale, 'search')}</label>
    <input
      id="term-search"
      class="input"
      type="search"
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      data-term-search
      data-slot="input"
    />
  </div>
  <label class="sr-only" for="source-filter">{t(locale, 'filterSource')}</label>
  <select id="source-filter" class="select source-select" data-source-filter aria-label={t(locale, 'filterSource')}>
    <option value="">{t(locale, 'allSources')}</option>
    {sources.map((s) => <option value={s.toLowerCase()}>{s}</option>)}
  </select>
  <label class="sr-only" for="sort-filter">{t(locale, 'sortLabel')}</label>
  <select id="sort-filter" class="select sort-select" data-sort-filter aria-label={t(locale, 'sortLabel')}>
    <option value="newest">{t(locale, 'sortNewest')}</option>
    <option value="score">{t(locale, 'sortScore')}</option>
    <option value="name">{t(locale, 'sortName')}</option>
  </select>
</form>

<div
  class="listing-grid"
  data-testid="directory-listing-grid"
  data-view="grid"
  data-timeline
>
  {entries.length === 0 ? (
    <div class="empty">
      <strong>{t(locale, 'empty')}</strong>
      <p>{t(locale, 'emptyHint')}</p>
    </div>
  ) : (
    entries.map((entry) => <TermCard locale={locale} entry={entry} />)
  )}
  <div class="empty" data-no-results hidden>
    <strong>{t(locale, 'noResults')}</strong>
  </div>
</div>

<script>
  const search = document.querySelector('[data-term-search]') as HTMLInputElement | null;
  const source = document.querySelector('[data-source-filter]') as HTMLSelectElement | null;
  const sort = document.querySelector('[data-sort-filter]') as HTMLSelectElement | null;
  const grid = document.querySelector('[data-timeline]') as HTMLElement | null;
  const empty = document.querySelector('[data-no-results]') as HTMLElement | null;

  function cards(): HTMLElement[] {
    return Array.from(document.querySelectorAll('[data-term-card]')) as HTMLElement[];
  }

  function applyFilter() {
    const q = (search?.value || '').trim().toLowerCase();
    const src = (source?.value || '').trim().toLowerCase();
    let visible = 0;
    for (const card of cards()) {
      const term = card.dataset.term || '';
      const excerpt = card.dataset.excerpt || '';
      const cardSource = card.dataset.source || '';
      const matchQ = !q || term.includes(q) || excerpt.includes(q) || cardSource.includes(q);
      const matchS = !src || cardSource === src;
      const show = matchQ && matchS;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    }
    empty?.toggleAttribute('hidden', visible !== 0 || cards().length === 0);
  }

  function applySort() {
    if (!grid) return;
    const mode = sort?.value || 'newest';
    const list = cards();
    const sorted = [...list].sort((a, b) => {
      if (mode === 'score') {
        return (Number(b.dataset.score) || 0) - (Number(a.dataset.score) || 0);
      }
      if (mode === 'name') {
        return (a.dataset.term || '').localeCompare(b.dataset.term || '');
      }
      return 0; // newest = original order from server
    });
    if (mode === 'newest') return; // keep DOM order
    for (const card of sorted) grid.appendChild(card);
    if (empty) grid.appendChild(empty);
  }

  search?.addEventListener('input', applyFilter);
  source?.addEventListener('change', applyFilter);
  sort?.addEventListener('change', () => {
    applySort();
    applyFilter();
  });
</script>
