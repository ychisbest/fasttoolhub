---
import type { CollectionEntry } from 'astro:content';
import { type Locale } from '../i18n/ui';
import { termPath, formatDate } from '../i18n/paths';
import { displayText } from '../lib/source';
import { plainTextFromMarkdown } from '../lib/markdown';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'terms'>;
}

const { locale, entry } = Astro.props;
const { term, source, score, excerpt, slug, intro, date } = entry.data;
const dateText = formatDate(date, locale);
// Prefer intro (locale-correct) over excerpt (often English even on zh), then term.
const description = plainTextFromMarkdown(
  displayText(intro || excerpt || term || '')
);
const scoreText = score.toFixed(2);
const initial = term.trim().slice(0, 2);
const ariaLabel = locale === 'zh' ? `查看 ${term}` : `View ${term}`;
---

<div
  class="term-card"
  data-slot="card"
  data-size="default"
  data-testid="directory-listing-card"
  data-term-card
  data-term={term.toLowerCase()}
  data-source={source.toLowerCase()}
  data-excerpt={description.toLowerCase()}
  data-score={score}
>
  <div class="card-top">
    <span class="card-favicon" data-testid="directory-listing-favicon" aria-hidden="true">{initial}</span>
    <h2 class="card-title">{term}</h2>
    <span class="card-stars" data-testid="directory-listing-stars">
      <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.5l2.9 6.1 6.7.7-5 4.6 1.4 6.5L12 16.9 5.9 20.4 7.3 13.9 2.4 9.3l6.7-.7L12 2.5z"></path>
      </svg>
      <span>{scoreText}</span>
    </span>
  </div>

  <div class="card-body">
    <p class="card-tagline" data-testid="directory-listing-tagline">{description}</p>
    <div class="card-badges">
      <span class="badge" data-slot="badge" data-variant="outline" title={source}>{source}</span>
      <time class="card-date" datetime={typeof date === 'string' ? date : date.toISOString()}>{dateText}</time>
    </div>
  </div>

  <a class="card-link" data-testid="directory-listing-link" href={termPath(locale, slug)} aria-label={ariaLabel}></a>
</div>
