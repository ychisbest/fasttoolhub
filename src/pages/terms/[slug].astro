---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermArticle from '../../components/TermArticle.astro';
import { getTermsByLocale } from '../../lib/terms';
import { renderMarkdown } from '../../lib/markdown';
import { termPath } from '../../i18n/paths';

export async function getStaticPaths() {
  const entries = await getTermsByLocale('zh');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const locale = 'zh' as const;
const { term, date, source, score, url, excerpt, intro, explain, usage, slug } = entry.data;
---

<BaseLayout
  locale={locale}
  title={term}
  description={excerpt || intro}
  ogType="article"
  canonicalPath={termPath(locale, slug)}
>
  <TermArticle
    locale={locale}
    term={term}
    date={date}
    source={source}
    score={score}
    url={url}
    slug={slug}
    introHtml={renderMarkdown(intro)}
    explainHtml={renderMarkdown(explain)}
    usageHtml={renderMarkdown(usage)}
  />
</BaseLayout>
