---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getTermsByLocale } from '../../lib/terms';
import { homePath } from '../../i18n/paths';
import { t } from '../../i18n/ui';

const locale = 'en' as const;
const entries = await getTermsByLocale(locale);
---

<BaseLayout locale={locale} title={t(locale, 'heroTitle')} description={t(locale, 'heroSubtitle')} canonicalPath={homePath(locale)}>
  <Timeline locale={locale} entries={entries} />
</BaseLayout>
