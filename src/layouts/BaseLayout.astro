---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { homePath, switchLocalePath, withBase } from '../i18n/paths';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogType?: string;
  canonicalPath?: string;
}

const {
  locale,
  title,
  description,
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteName = t(locale, 'siteName');
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${t(locale, 'tagline')}`;
const desc = description ?? t(locale, 'heroSubtitle');
const canonical = new URL(canonicalPath, Astro.site).toString();
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(switchLocalePath(canonicalPath, 'zh'), Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(switchLocalePath(canonicalPath, 'en'), Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(homePath('zh'), Astro.site).toString()} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('fth-theme');
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          if (saved === 'light' || saved === 'dark') {
            root.classList.add(saved);
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.classList.add('dark');
          } else {
            root.classList.add('light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main-content">{t(locale, 'skip')}</a>
    <div class="page-shell">
      <Header locale={locale} />
      <div class="container" style="display:flex;flex:1;flex-direction:column;width:100%">
        <main id="main-content" class="main-content">
          <slot />
        </main>
        <Footer locale={locale} />
      </div>
    </div>
  </body>
</html>
